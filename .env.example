APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# IMPORTANTE: Em hospedagem compartilhada como Hostinger, mantenha QUEUE_CONNECTION=sync
# para que notificações de novo lead e pós-respostas (afterResponse) executem imediatamente
# sem necessidade de daemon 'queue:work' rodando 24/7.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------------------
# PRODUÇÃO (Hostinger): use as linhas abaixo no .env do servidor
# Laravel 13 usa MAIL_SCHEME (não existe mais MAIL_ENCRYPTION).
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtps        # 465 = SSL implícito
#   MAIL_HOST=smtp.hostinger.com
#   MAIL_PORT=465
#   MAIL_USERNAME=contato@augepanamby.net.br
#   MAIL_PASSWORD="senha_do_email"
#   MAIL_FROM_ADDRESS="contato@augepanamby.net.br"
#   MAIL_FROM_NAME="Auge Panamby"
# -------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -------------------------------------------------------------
# FRONTEND & CORS CONFIGURATION
# -------------------------------------------------------------
FRONTEND_URL=https://augepanamby.net.br
# CORS_ALLOWED_ORIGINS=https://augepanamby.net.br,https://www.augepanamby.net.br

# -------------------------------------------------------------
# LEADS & LGPD CONFIGURATION
# -------------------------------------------------------------
LEAD_NOTIFY_EMAIL=contato@augepanamby.net.br
LEAD_RETENTION_DAYS=730
LEAD_CONSENT_VERSION=2026-09
LEAD_DEDUPE_MINUTES=5
# Fuso usado para exibir datas nas notificações (a app grava datas em UTC)
LEAD_TIMEZONE=America/Sao_Paulo

